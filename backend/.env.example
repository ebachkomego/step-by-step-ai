# Google Gemini API Key
# Получите бесплатный ключ за пару секунд: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Или OpenAI API Key (опционально, если используется OpenAI)
OPENAI_API_KEY=

# Настройки сервера
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
